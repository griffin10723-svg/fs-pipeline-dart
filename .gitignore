# 비밀값 — 절대 커밋 금지
# DART 인증키는 .env 에만 두고, 형식만 보여주는 .env.example 은 커밋한다.
.env
.env.*
!.env.example

# Python 실행 부산물
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# 가상환경 — uv sync 로 재생성한다. uv.lock 은 커밋할 것.
.venv/
venv/

# 데이터 — 용량이 크고 스크립트로 다시 만들 수 있다.
# 재현성은 "데이터를 올리는 것"이 아니라 "수집 스크립트가 도는 것"으로 담보한다.
data/
*.parquet
*.csv

# 결과물 — 용량 보고 판단. README 에 넣을 그림은 아래 negate 규칙으로 예외 처리한다.
outputs/*
!outputs/figures/
outputs/figures/*
!outputs/figures/*.png

# OS / 편집기
.DS_Store
Thumbs.db
.vscode/

# forge headroom이 압축 전 원본을 보관하는 폴더
.headroom-cache/

# 테스트 입력·기준 결과는 커밋한다(위의 *.csv·*.parquet 규칙의 예외). 재현성과 골든 비교에 필요하다.
!tests/fixtures/**
!tests/golden/**
